<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Security floors for PDFsharp and Data Protection; keep these explicit so
         the API's shared-framework pruning cannot select PDFsharp's older PKCS. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="AngleSharp" Version="1.8.4" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <ProjectReference Include="..\MwabuLearn.Domain\MwabuLearn.Domain.csproj" />
    <ProjectReference Include="..\MwabuLearn.Application\MwabuLearn.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Lessons/Reference/syllabus-2023.json" />
    <EmbeddedResource Include="Lessons/Reference/mwabu-lesson-plan.pdf" />
    <EmbeddedResource Include="Content/scormAdapter.js" LogicalName="Mwabu.ScormAdapter.js" />
  </ItemGroup>

</Project>

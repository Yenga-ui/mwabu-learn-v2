# Copy to a deployment secret store/ignored environment file. Blank values are intentional, never defaults.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ConnectionStrings__MwabuLearnDb=
Database__CommandTimeoutSeconds=30
Database__ConnectionTimeoutSeconds=15
Database__MaximumPoolSize=100
Jwt__Issuer=https://api.example.org
Jwt__Audience=mwabu-learn-api
Jwt__SigningKeyBase64=
Jwt__AccessTokenMinutes=15
Sessions__IdleDays=45
Sessions__AbsoluteDays=180
Sessions__PasswordResetMinutes=30
DataProtection__PersistKeysInDatabase=true
DataProtection__Certificate__Path=/run/secrets/mwabu-protection.pfx
DataProtection__Certificate__Password=
HttpSecurity__AllowedOrigins__0=https://admin.example.org
HttpSecurity__ForwardedHeadersEnabled=false
# Enable only with actual exact trusted proxy addresses.
# HttpSecurity__KnownProxies__0=10.0.0.10
HttpSecurity__ForwardLimit=1
ContentStorage__Provider=S3
ContentStorage__S3__Bucket=
ContentStorage__S3__Region=
# Optional: HTTPS endpoint for a compatible provider; never disable TLS verification.
# ContentStorage__S3__ServiceUrl=https://objects.example.org
ContentStorage__S3__ForcePathStyle=false
ContentStorage__S3__SpoolDirectory=/app/.local/uploads
# Prefer managed workload credentials. If environment credentials are required, supply them privately.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BackgroundWork__Enabled=true
BackgroundWork__PollSeconds=10
BackgroundWork__BatchSize=20
BackgroundWork__LeaseSeconds=120
BackgroundWork__MaximumAttempts=8
Devices__CredentialDays=180
Sync__CursorDays=30
Sync__MaximumBatchBytes=2097152
Traffic__AuthIpPerMinute=1000
Traffic__ApiPerUserPerMinute=600
Traffic__SearchPerMinute=120
Traffic__UploadPerMinute=20
Traffic__SyncPerMinute=120
Traffic__ConcurrentDownloadsPerUser=4
BootstrapAdministrator__Enabled=false
Observability__Enabled=true
Observability__SampleRatio=0.1
Observability__ExportOtlp=false
# Observability__OtlpEndpoint=https://collector.example.org:4317
# OTEL_EXPORTER_OTLP_HEADERS= supplied privately if required by the collector
